{
  "name": "shima-enaga-pet",
  "version": "1.0.0",
  "description": "北長尾山雀（シマエナガ）桌面寵物 —— 離線、無素材檔案，全部程序生成",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.shima-enaga.pet",
    "productName": "ShimaEnaga",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "identity": null
    }
  },
  "author": "shima-enaga-pet"
}